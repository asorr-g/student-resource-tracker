@model StudentResourceTracker.Models.Student
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0"><i class="bi bi-person me-2 text-primary"></i>@Model.FullName</h2>
    <div class="ms-auto d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:64px;height:64px;font-size:1.6rem;">
                    @Model.FirstName[0]@Model.LastName[0]
                </div>
                <h5 class="fw-bold mb-0">@Model.FullName</h5>
                <p class="text-muted small">@Model.Email</p>
                @if (!string.IsNullOrEmpty(Model.Course))
                {
                    <span class="badge bg-info text-dark">@Model.Course</span>
                }
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Student ID</span>
                    <span>@(Model.StudentNumber ?? "—")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Enrolled</span>
                    <span>@Model.EnrolledOn.ToString("MMM dd, yyyy")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted">Resources</span>
                    <span class="badge bg-primary rounded-pill">@Model.Resources.Count</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-journal-richtext me-2 text-primary"></i>Assigned Resources</span>
                <a asp-controller="Resources" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus me-1"></i>Add Resource
                </a>
            </div>
            @if (!Model.Resources.Any())
            {
                <div class="card-body text-center text-muted py-4">
                    No resources assigned yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Resources.OrderByDescending(r => r.AddedOn))
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(r.Url))
                                        {
                                            <a href="@r.Url" target="_blank" class="text-decoration-none">
                                                @r.Title <i class="bi bi-box-arrow-up-right small"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            @r.Title
                                        }
                                    </td>
                                    <td class="text-muted small">@(r.Category?.Name ?? "—")</td>
                                    <td><span class="badge bg-light text-dark border">@r.Type</span></td>
                                    <td class="text-center">
                                        @if (r.IsCompleted)
                                        {
                                            <span class="badge bg-success">Done</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
