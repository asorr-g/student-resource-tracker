@model StudentResourceTracker.ViewModels.ResourceFilterViewModel
@{
    ViewData["Title"] = "Resources";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-journal-richtext me-2 text-primary"></i>Resources</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Add Resource
    </a>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                       class="form-control form-control-sm" placeholder="Title or description..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Student</label>
                <select name="SelectedStudentId" class="form-select form-select-sm" asp-items="Model.Students">
                    <option value="">All students</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Category</label>
                <select name="SelectedCategoryId" class="form-select form-select-sm" asp-items="Model.Categories">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="ShowCompleted" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="false" selected="@(Model.ShowCompleted == false)">Pending</option>
                    <option value="true" selected="@(Model.ShowCompleted == true)">Completed</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Resources.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-journal-richtext display-4 mb-3 d-block"></i>
            No resources found.
            <div class="mt-3"><a asp-action="Create" class="btn btn-primary btn-sm">Add your first resource</a></div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Student</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Added</th>
                        <th class="text-center">Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Resources)
                    {
                        <tr class="@(r.IsCompleted ? "table-success text-muted" : "")">
                            <td>
                                <div class="fw-semibold">
                                    @if (!string.IsNullOrEmpty(r.Url))
                                    {
                                        <a href="@r.Url" target="_blank" class="text-decoration-none">
                                            @r.Title <i class="bi bi-box-arrow-up-right small"></i>
                                        </a>
                                    }
                                    else { @r.Title }
                                </div>
                                @if (!string.IsNullOrEmpty(r.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width:280px;">@r.Description</div>
                                }
                            </td>
                            <td class="small">@(r.Student?.FullName ?? "—")</td>
                            <td class="small">@(r.Category?.Name ?? "—")</td>
                            <td><span class="badge bg-light text-dark border">@r.Type</span></td>
                            <td class="text-muted small">@r.AddedOn.ToString("MMM dd, yyyy")</td>
                            <td class="text-center">
                                <form asp-action="ToggleComplete" asp-route-id="@r.Id" method="post">
                                    <button type="submit" class="btn btn-sm @(r.IsCompleted ? "btn-success" : "btn-outline-secondary")"
                                            title="@(r.IsCompleted ? "Mark as pending" : "Mark as done")">
                                        <i class="bi @(r.IsCompleted ? "bi-check-circle-fill" : "bi-circle")"></i>
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small bg-white">
            Showing @Model.Resources.Count() resource@(Model.Resources.Count() == 1 ? "" : "s")
        </div>
    </div>
}
