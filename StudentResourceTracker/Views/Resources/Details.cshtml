@model StudentResourceTracker.Models.Resource
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0 text-truncate"><i class="bi bi-journal-text me-2 text-primary"></i>@Model.Title</h2>
    <div class="ms-auto d-flex gap-2 flex-shrink-0">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="col-12">
                            <h6 class="text-muted text-uppercase small mb-1">Description</h6>
                            <p>@Model.Description</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Url))
                    {
                        <div class="col-12">
                            <h6 class="text-muted text-uppercase small mb-1">URL</h6>
                            <a href="@Model.Url" target="_blank" class="text-break">
                                @Model.Url <i class="bi bi-box-arrow-up-right ms-1"></i>
                            </a>
                        </div>
                    }
                    <div class="col-md-4">
                        <h6 class="text-muted text-uppercase small mb-1">Type</h6>
                        <span class="badge bg-light text-dark border fs-6">@Model.Type</span>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted text-uppercase small mb-1">Student</h6>
                        @if (Model.Student != null)
                        {
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@Model.Student.Id">
                                @Model.Student.FullName
                            </a>
                        }
                        else { <span class="text-muted">Unassigned</span> }
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted text-uppercase small mb-1">Category</h6>
                        <span>@(Model.Category?.Name ?? "—")</span>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted text-uppercase small mb-1">Added</h6>
                        <span>@Model.AddedOn.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted text-uppercase small mb-1">Status</h6>
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6"><i class="bi bi-circle me-1"></i>Pending</span>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <form asp-action="ToggleComplete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn @(Model.IsCompleted ? "btn-outline-secondary" : "btn-success")">
                            <i class="bi @(Model.IsCompleted ? "bi-arrow-counterclockwise" : "bi-check2-circle") me-1"></i>
                            @(Model.IsCompleted ? "Mark as Pending" : "Mark as Completed")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
