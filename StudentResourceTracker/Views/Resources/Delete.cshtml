@model StudentResourceTracker.Models.Resource
@{
    ViewData["Title"] = "Delete Resource";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm" style="border-top: 3px solid #dc3545 !important;">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3"></i>
                <h4>Delete Resource?</h4>
                <p class="text-muted">
                    You're about to permanently delete <strong>@Model.Title</strong>. This cannot be undone.
                </p>

                <div class="card bg-light border-0 text-start my-3 p-3">
                    <div><strong>Type:</strong> @Model.Type</div>
                    <div><strong>Student:</strong> @(Model.Student?.FullName ?? "Unassigned")</div>
                    <div><strong>Category:</strong> @(Model.Category?.Name ?? "—")</div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2 mt-3">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Yes, Delete
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
